for apo-
 cd "/mnt/e/Ayub sir Research/Akram/Protein -1 7aiy/apo/run 1"

gmx anaeig -v Analysis/pca/eigenvec.trr \
           -f Analysis/pca/concat_fit.xtc \
           -s MD.tpr \
           -first 1 -last 3 \
           -proj Analysis/pca/proj.xvg


📊 STEP 3 — Plot PCA projections (PC1–PC2, PC1–PC3, PC2–PC3)

Go to PCA folder:

cd "/mnt/e/Ayub sir Research/Akram/Protein -1 7aiy/holo/ligand 3/Analysis/pca"


Create and open script:

nano plot_pca_projections.py

Paste this (same as yours, but verified and corrected):
===============================================================================
#!/usr/bin/env python3
import numpy as np
import matplotlib.pyplot as plt
import os, sys

# === INPUT ===
xvg_file = sys.argv[1]  # path to proj.xvg
system_name = sys.argv[2] if len(sys.argv) > 2 else "System"

# === LOAD DATA ===
data = np.genfromtxt(xvg_file, comments='#', invalid_raise=False)
if data.ndim == 1:  # handle edge case where file has only one column
    data = np.genfromtxt(xvg_file, comments='@', invalid_raise=False)
data = data[~np.isnan(data).any(axis=1)]

time = data[:,0]
pc1, pc2, pc3 = data[:,1], data[:,2], data[:,3]

# === PLOTS ===
out_dir = os.path.dirname(xvg_file)

def scatter_plot(x, y, xlabel, ylabel, fname):
    plt.figure(figsize=(6,5))
    plt.scatter(x, y, s=8, c=time, cmap='viridis')
    plt.xlabel(xlabel)
    plt.ylabel(ylabel)
    plt.title(f"{system_name}: {xlabel} vs {ylabel}")
    plt.colorbar(label='Time (ns)')
    plt.tight_layout()
    plt.savefig(os.path.join(out_dir, fname), dpi=300)
    plt.close()

scatter_plot(pc1, pc2, 'PC1', 'PC2', 'PCA_PC1_PC2.png')
scatter_plot(pc1, pc3, 'PC1', 'PC3', 'PCA_PC1_PC3.png')
scatter_plot(pc2, pc3, 'PC2', 'PC3', 'PCA_PC2_PC3.png')

print(f"PCA plots saved in {out_dir}")
===================================================================================
