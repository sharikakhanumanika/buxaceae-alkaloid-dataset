Command 1: Compute covariance matrix

cd "/mnt/e/Ayub sir Research/Akram/Protein -1 7aiy/holo/ligand 1"
gmx covar -s "run 1/MD.tpr" \
          -f Analysis/pca/concat_fit.xtc \
          -o Analysis/pca/eigenval.xvg \
          -v Analysis/pca/eigenvec.trr

